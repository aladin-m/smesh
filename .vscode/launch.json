{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      
        {
            "type": "gdb",
            "request": "attach",
            "name": "Attach to PID",
            "target": "${input:FindSalomePID}",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText"
        }
    ],
    "inputs": [
        {
          "id": "FindSalomePID",
          "type": "command",
          "command": "shellCommand.execute",
          "args": {
            "command": "pgrep 'SALOME_Session' -f",
            "description": "Select your Salom PID",
            "useFirstResult": true,
          }
        }
    ]
}